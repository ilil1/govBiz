# LLM 검색 의도 분석
# 실제 키는 로컬 .env에만 입력하고 커밋하지 마세요.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
LLM_MODEL_TIMEOUT_SECONDS=2.0
LLM_RUN_TIMEOUT_SECONDS=2.5
# Core API 제한시간은 agent run 제한시간보다 응답 처리 여유만큼 길게 유지합니다.
AI_SERVICE_READ_TIMEOUT=3s

# 공공데이터포털 중소기업 지원사업 공고 조회 서비스의 개인 서비스키
# Encoding 또는 Decoding 키를 그대로 입력하면 Core API가 외부 호출 전에 정규화합니다.
DATA_GO_KR_SERVICE_KEY=

# 일반 실행에서는 아래 기본값을 그대로 사용합니다. 로컬 스텁이나 timeout 조정이 필요할 때만
# 주석을 해제하세요.
# BIZINFO_API_BASE_URL=https://apis.data.go.kr
# BIZINFO_API_CONNECT_TIMEOUT=2s
# BIZINFO_API_READ_TIMEOUT=10s
